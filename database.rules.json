{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,

    "avatars": {
      "$uid": {
        /* Any signed-in user can read an avatar; owner-only write, overwrite allowed
           so the user can change avatar. Deleting (newData not existing) is allowed.
           700000 chars is the base64 cap enforced client-side by AvatarService. */
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && newData.val().length <= 700000))"
      }
    },

    "chatAttachments": {
      "$uid": {
        "$attachmentId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isString() && newData.val().length <= 700000"
        }
      }
    }
  }
}
